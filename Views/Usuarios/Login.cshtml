@model rivarola_riquelme_rastrilla.Models.Usuarios

@{
    ViewData["Title"] = "Login";
}

<h2 class="text-center mb-5">Iniciar Sesión</h2>

<div class="row justify-content-center">
    <div class="col-md-4">
        <form asp-action="Login" method="post">
            <div class="form-group mb-4">
                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Ingrese su email" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Contrasenia" class="control-label">Contraseña</label>
                <input asp-for="Contrasenia" type="password" class="form-control" placeholder="Ingrese su contraseña"
                    required />
                <span asp-validation-for="Contrasenia" class="text-danger"></span>
            </div>
            <div class="form-group mt-3 row">
                <button type="submit" class="btn btn-custom btn-block col-md-4">Iniciar Sesión</button>
                <small class="col-md-8 text-end" style="cursor: pointer;color: #b31b11" data-bs-toggle="modal"
                    data-bs-target="#recuperarModal">¿Olvidaste tu
                    contraseña?</small>
            </div>
        </form>

        <div class="modal fade" id="recuperarModal" tabindex="-1" aria-labelledby="recuperarModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-dark">
                        <h5 class="modal-title text-light" id="recuperarModalLabel">Recuperar Contraseña</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                            style="filter: invert(1);"></button>
                    </div>
                    <div class="modal-body">
                        <form asp-action="EnviarCorreoRestaurarContrasenia" asp-controller="Usuarios" method="post">
                            <div class="form-group mt-0 row">
                                <label for="Email" class="control-label col-md-12">Email</label>
                                <input name="Email" class="form-control w-75 col-md-8" placeholder="Ingrese su email"
                                    required />
                                <div class="spinner-border text-secondary col-md-4 m-auto d-none" id="spinner"
                                    role="status">
                                    <span class="sr-only">Loading...</span>
                                </div>
                            </div>
                            <div class="form-group my-3">
                                <input type="submit" value="Recuperar"
                                    onclick="document.getElementById('spinner').classList.remove('d-none');"
                                    class="btn btn-custom">
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center my-3">
                @ViewBag.Error
            </div>
        }
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        @if (TempData["ToastMessage"] != null)
            {
                <text>
                    showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
                </text>
        }
    });

    function showToast(message, type) {
        const toastId = `toast-${Date.now()}`; // ID único para el toast
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;

        const toastContainer = document.getElementById('toastContainer');
        toastContainer.insertAdjacentHTML('beforeend', toastHtml);

        const toastElement = document.getElementById(toastId);
        const bootstrapToast = new bootstrap.Toast(toastElement);
        bootstrapToast.show();

        // Eliminar el toast del DOM cuando se oculta
        toastElement.addEventListener('hidden.bs.toast', () => {
            toastElement.remove();
        });
    }
</script>