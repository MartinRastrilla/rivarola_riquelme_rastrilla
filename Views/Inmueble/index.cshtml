@model IEnumerable<rivarola_riquelme_rastrilla.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
}

<div>
    <h1 class="display-4">Lista de Inmuebles</h1>
</div>

<p>
    <a asp-action="AltaInmueble" class="btn btn-custom">Agregar Inmueble</a>
</p>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="FiltrarTipo" method="get">
    <div class="form-group">
        <label for="tipoInmueble">Seleccione el tipo de inmueble:</label>
        <select id="tipoInmueble" name="tipoInmueble" class="form-control">
            <option value="0"></option>
           @foreach (var tipo in ViewBag.tipos as List<Tipo>)
            {
                <option value="@tipo.Id">@tipo.Nombre</option>
           }
        </select>
    </div>
    <button type="submit" class="btn btn-custom">Filtrar</button>
</form>

<br>

<form asp-action="FiltrarPrecio" method="get">
    <div class="form-group">
        <label for="precioMin">Precio Mínimo:</label>
        <input type="number" id="precioMin" name="precioMin" class="form-control" min="0" />
    </div>

    <div class="form-group">
        <label for="precioMax">Precio Máximo:</label>
        <input type="number" id="precioMax" name="precioMax" class="form-control" min="0" />
    </div>

    <button type="submit" class="btn btn-custom">Filtrar por Precio</button>
</form>
<br>

<form asp-action="FiltrarUso" method="get">
    <div class="form-group">
        <label for="usoInmueble">Seleccione el uso del inmueble:</label>
        <select id="usoInmueble" name="usoInmueble" class="form-control">
            <option value="0"></option>
            <option value="residencial">Residencial</option>
            <option value="comercial">Comercial</option>
        </select>
    </div>
    <button type="submit" class="btn btn-custom">Filtrar</button>
</form>

<br>
<form asp-action="FiltrarAmbientes" method="get">
   <div class="form-group">
        <label for="ambientes">Seleccione el número de ambientes:</label>
        <input type="number" id="ambientes" name="ambientes" class="form-control" min="0" />
    </div>
    <button type="submit" class="btn btn-custom">Filtrar</button>
</form>
<br>

<table class="table text-center">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Direccion)</th>
            <th>Propietario</th>
            <th>@Html.DisplayNameFor(model => model.Uso)</th>
            <th>@Html.DisplayNameFor(model => model.Tipo)</th>
            <th>@Html.DisplayNameFor(model => model.Ambientes)</th>
            <th>@Html.DisplayNameFor(model => model.Precio)</th>
            <th>@Html.DisplayNameFor(model => model.Estado)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in ViewBag.inmuebles as List<Inmueble>) 
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Direccion)
                </td>
                <td>
                    @item.Propietario.Nombre @item.Propietario.Apellido
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Uso)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Tipo.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Ambientes)
                </td>
                <td>
                    $@Html.DisplayFor(modelItem => item.Precio)
                </td>
                <td>
                    @if (item.Estado)
                    {
                        <a href="/Inmueble/Baja/@item.Id" class="btn btn-desactivar"></a>
                    }
                    else
                    {
                        <a href="/Inmueble/Activar/@item.Id" class="btn btn-activar"></a>
                    }
                </td>
                <td>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a href="/Inmueble/Delete/@item.Id" class="me-2"><i class="fa-solid fa-trash ic-sz ic-color"></i></a>
                    }
                    <a href="/Inmueble/Editar/@item.Id" class="me-2"><i class="fa-solid fa-pencil ic-sz ic-color"></i></a>
                    <a href="/Inmueble/Details/@item.Id"><i class="fa-solid fa-circle-info ic-sz ic-color"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    .btn-desactivar {
        padding: 1.2rem 3.2rem;
        background-color: #C0392B;
        color: white;
        border-radius: 7px;
        position: relative;
        cursor: pointer;
        overflow: hidden;
    }

    .btn-desactivar::before {
        content: 'Disponible';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        transition: transform 0.2s ease, opacity 0.2s ease;
        color: white;
    }

    .btn-desactivar::after {
        content: 'Desactivar';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0);
        transition: transform 0.2s ease, opacity 0.2s ease;
        color: white;
        opacity: 0;
    }

    .btn-desactivar:hover {
        background-color: #ff2c15;
    }

    .btn-desactivar:hover::before {
        transform: translate(-50%, -50%) scale(3);
        opacity: 0;
    }

    .btn-desactivar:hover::after {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
    }


    .btn-activar {
        padding: 1.2rem 3.2rem;
        font-size: 1rem;
        background-color: #C0392B;
        color: white;
        border-radius: 7px;
        position: relative;
        cursor: pointer;
        overflow: hidden;
    }

    .btn-activar::before {
        content: 'No Disponible';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        transition: transform 0.2s ease, opacity 0.2s ease;
        color: white;
    }

    .btn-activar::after {
        content: 'Activar';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0);
        transition: transform 0.2s ease, opacity 0.2s ease;
        color: white;
        opacity: 0;
    }

    .btn-activar:hover {
        background-color: #09ab03;
    }

    .btn-activar:hover::before {
        transform: translate(-50%, -50%) scale(3);
        opacity: 0;
    }

    .btn-activar:hover::after {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
    }
</style>
