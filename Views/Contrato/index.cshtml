@model ContratoViewModel

@{
    ViewData["Title"] = "Contratos";
}

<link rel="stylesheet" href="~/css/pagination.css">

<div class="text-center mb-5">
    <h1 class="display-5">Lista de Contratos</h1>
</div>
<div class="my-3 row">
    <p class="col-md-9 mb-0 align-self-center">
        <a href="/Contrato/AltaContrato" class="btn btn-custom" style="margin-right: 15px">Agregar <i class="fa-solid fa-plus"></i></a>
        <!-- Botón para abrir el modal -->
        <button type="button" class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#filtrarFechaModal">
            <i class="fa-regular fa-calendar"></i> Filtrar por Fecha
        </button>
        <a href="@Url.Action("Index")" class="btn btn-custom">
            <i class="fa-solid fa-xmark"></i>
        </a>
    </p>
    <form asp-action="Index" method="GET" class="input-wrapper col-md-3" id="searchForm">
            <button type="submit" class="icon" id="searchButton">
                <i class="fa-solid fa-magnifying-glass fs-3 fa-bounce"></i>
            </button>
            <input type="text" name="search" id="searchInput" class="input" placeholder="Buscar Contrato..."
                value="@ViewBag.Search">
    </form>
</div>




<!-- Modal de Bootstrap -->
<div class="modal fade" id="filtrarFechaModal" tabindex="-1" aria-labelledby="filtrarFechaModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <!-- Encabezado del modal -->
            <div class="modal-header">
                <h5 class="modal-title" id="filtrarFechaModalLabel">Filtrar por Fecha</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Cuerpo del modal -->
            <div class="modal-body">
                <form asp-action="FiltrarFecha" method="get" onsubmit="return validarFechas()">
                    <div class="form-row mb-3">
                        <div class="col">
                            <label for="fechaInicio">Fecha de Inicio</label>
                            <input type="date" id="fechaInicio" name="fechaInicio" class="form-control"
                                value="@ViewData["fechaInicio"]" />
                        </div>
                        <div class="col">
                            <label for="fechaFin">Fecha de Finalización</label>
                            <input type="date" id="fechaFin" name="fechaFin" class="form-control"
                                value="@ViewData["fechaFin"]" />
                        </div>
                        <div class="col align-self-end mt-3">
                            <button type="submit" class="btn btn-custom">Filtrar</button>
                        </div>
                    </div>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }
                </form>
            </div>
            <!-- Pie del modal -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<table class="table text-center table-striped table-hover">
    <thead>
        <tr>
            <th>Inquilino</th>
            <th>Inmueble</th>
            <th>Estado</th>
            <th>Monto</th>
            <th>Fecha de Inicio</th>
            <th>Fecha de Finalización</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Contratos != null)
            @foreach (var item in Model.Contratos)
            {
                <tr>
                    <td>
                        <a href="/Inquilino/Details?Dni=@item.Inquilino_dni" style="color:#C0392B;">@item.Inquilino?.Nombre
                            @item.Inquilino?.Apellido</a>
                    </td>
                    <td>
                        <a href="/Inmueble/Details/@item.Inmueble_id" style="color:#C0392B;">@item.Inmueble?.Direccion</a>
                    </td>
                    <td>
                        @if (item.Estado == Contratos.EstadoContrato.Activo)
                        {
                            <span class="badge" style="background-color: #dab900;">Activo</span>
                        }
                        else if (item.Estado == Contratos.EstadoContrato.Cancelado)
                        {
                            <span class="badge bg-danger">Cancelado</span>
                        }else
                        {
                            <span class="badge bg-success">Finalizado</span>
                        }
                    </td>
                    <td>$@Html.DisplayFor(modelItem => item.Monto)</td>
                    <td>@String.Format("{0:dd/MM/yyyy}", item.Fecha_inicio)</td>
                    <td>@String.Format("{0:dd/MM/yyyy}", item.Fecha_fin)</td>
                    <td>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a href="/Contrato/Delete/@item.Id" class="me-2"><i class="fa-solid fa-trash ic-sz ic-color"></i></a>
                        }
                        <a href="/Contrato/Editar/@item.Id" class="me-2"><i class="fa-solid fa-pencil ic-sz ic-color"></i></a>
                        <a href="/Contrato/Details/@item.Id" class="me-2"><i
                                class="fa-solid fa-circle-info ic-sz ic-color"></i></a>
                        <a asp-controller="contrato" asp-action="Pagos" asp-route-contratoId="@item.Id" class="me-2"><i
                                class="fa-solid fa-file-invoice-dollar ic-sz ic-color"></i></a>
                        <a data-bs-toggle="modal" data-bs-target="#aplicarMultaModal-@item.Id" style="cursor: pointer"><i
                                class="fa-solid fa-ban ic-sz ic-color"></i></a>
                    </td>
                    <div class="modal fade" id="aplicarMultaModal-@item.Id" tabindex="-1"
                        aria-labelledby="aplicarMultaModalLabel-@item.Id" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <!-- Encabezado del modal -->
                                <div class="modal-header bg-dark">
                                    <h5 class="modal-title" id="aplicarMultaModal-@item.Id">Aplicar Multa</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                                        style="filter: invert(1);"></button>
                                </div>
                                <!-- Cuerpo del modal -->
                                <div class="modal-body">
                                    <form action="Multa/AplicarMulta" method="post">
                                        @{
                                            if (Model.Multas != null && Model.Multas.Any(m => m.Contrato_id == item.Id)) {
                                                <div class="form-group text-center my-4">
                                                    <h3 class="pb-1" style="color: var(--rojo-principal); font-size: 17px">*ya se ha aplicado una multa a este Contrato*</h3>
                                                </div>
                                            }else{
                                            var totalDiasContrato = (item.Fecha_fin - item.Fecha_inicio).TotalDays;
                                            var diasTranscurridos = (DateTime.Now - item.Fecha_inicio).TotalDays;
                                            var mitadDelContrato = totalDiasContrato / 2;
                                            var multa = item.Inmueble?.Precio;
                                            var msj = "";
                                            if (diasTranscurridos > mitadDelContrato) {
                                                multa = item.Inmueble?.Precio;
                                                msj = "Los días transcurridos superan la mitad del contrato, por lo que no se aplicarán cargos mayores.(Sólo 1 mes Extra).";
                                            } else  if (diasTranscurridos < mitadDelContrato) {
                                                multa = item.Inmueble?.Precio * 2;
                                                msj = "Los días transcurridos NO superan la mitad del contrato, por lo que se aplicarán cargos mayores (2 meses Extras).";
                                            }
                                        
                                            <input type="hidden" name="Contrato_id" value="@item.Id" />
                                            <div class="form-group text-center">
                                                <h3 class="fs-5 border-bottom border-secondary pb-1">¿Está seguro que desea cancelar
                                                    el Contrato?</h3>
                                            </div>
                                            <div class="form-group text-center mt-3">
                                                <label for="" class="fs-5">Importe de la Multa: $@multa</label>
                                            </div>
                                            <input value="@multa" name="Monto" type="hidden">
                                            <input type="date" class="d-none" name="Fecha_multa" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                                            <div class="form-group text-center mt-1">
                                                <label for="" class="text-danger" style="font-size: 13px">*@msj*</label>
                                            </div>
                                            <div class="form-group text-center mt-4">
                                                <input type="submit" value="Aplicar Multa" class="btn btn-custom" />
                                            </div>
                                            }
                                        }
                                    </form>
                                </div>
                                <!-- Pie del modal -->
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </tr>
            }
    </tbody>
</table>
<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a href="/Contrato/Index?pagina=1" class="btn btn-custom">Primera</a>
    }

    @{
        int startPage = Math.Max(1, Model.CurrentPage - 1);
        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 1);

        for (int i = startPage; i <= endPage; i++)
        {
            if (i == Model.CurrentPage)
            {
                <span class="btn btn-custom active">@i</span>
            }
            else
            {
                <a href="/Contrato/Index?pagina=@i" class="btn btn-custom">@i</a>
            }
        }
    }

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="/Contrato/Index?pagina=@Model.TotalPages" class="btn btn-custom">Última</a>
    }
</div>

<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="toastContainer"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let toastMessage = "@TempData["ToastMessage"]".split("||");
        let toastType = "@TempData["ToastType"]".split("||");

        if (toastMessage.length > 0 && toastMessage[0] !== "") {
            for (let i = 0; i < toastMessage.length; i++) {
                showToast(toastMessage[i], toastType[i]);
            }
        }
    });

    function showToast(message, type) {
        const toastId = `toast-${Date.now()}`; // ID único para el toast
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0 mt-3" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;

        const toastContainer = document.getElementById('toastContainer');
        toastContainer.insertAdjacentHTML('beforeend', toastHtml);

        const toastElement = document.getElementById(toastId);
        const bootstrapToast = new bootstrap.Toast(toastElement);
        bootstrapToast.show();

        // Eliminar el toast del DOM cuando se oculta
        toastElement.addEventListener('hidden.bs.toast', () => {
            toastElement.remove();
        });
    }
</script>