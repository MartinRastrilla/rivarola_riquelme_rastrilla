@model PagoViewModel

@{
    ViewData["Title"] = "Pagos";
}

<link rel="stylesheet" href="~/css/pagination.css">

<div>
    <h1 class="display-5">Lista de Pagos</h1>
</div>

<p>
    <a asp-action="Crear" class="btn btn-custom">Agregar Pago</a>
</p>

<table class="table text-center table-striped table-hover mt-4">
    <thead>
        <tr>
            <th>Inquilino</th>
            <th>Dirección de Inmueble</th>
            <th>Fecha de Pago</th>
            <th>Detalle</th>
            <th>Importe</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Pagos != null)
        {
            @foreach (var item in Model.Pagos)
            {
                <tr>
                    <td>@item.Contrato?.Inquilino?.Nombre @item.Contrato?.Inquilino?.Apellido</td>
                    <td>@item.Contrato?.Inmueble?.Direccion</td>
                    <td>@String.Format("{0:dd/MM/yyyy}", item.Fecha_pago)</td>
                    <td><a data-bs-toggle="modal" data-bs-target="#detallePagoModal-@item.Id" style="cursor: pointer"><i
                                class="fa-solid fa-eye ic-sz ic-color"></i></a></td>
                    <td>$@Html.DisplayFor(modelItem => item.Importe)</td>
                    <td>
                        @if (item.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Anulado</span>
                        }
                    </td>
                    <td>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a href="/Pago/Delete/@item.Id" class="me-2"><i class="fa-solid fa-trash ic-sz ic-color"></i></a>
                        }
                        <a href="/Pago/Edit/@item.Id" class="me-2"><i class="fa-solid fa-pencil ic-sz ic-color"></i></a>
                        <a href="/Pago/Details/@item.Id" class="me-2"><i class="fa-solid fa-circle-info ic-sz ic-color"></i></a>
                        <a data-bs-toggle="modal" class="me-2 text-decoration-none" data-bs-target="#nuevoPagoModal-@item.Id">
                            <i class="fa-solid fa-plus ic-sz ic-color"></i>
                        </a>
                        <a data-bs-toggle="modal" data-bs-target="#anularPagoModal-@item.Id">
                            <i class="fa-solid fa-ban ic-sz ic-color"></i>
                        </a>
                        <div class="modal fade" id="anularPagoModal-@item.Id" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header bg-dark">
                                        <h5 class="modal-title text-light" id="anularPagoModalLabel-@item.Id">Anular Pago</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                                            style="filter: invert(1);"></button>
                                    </div>
                                    @if (item.Activo)
                                    {
                                        <div class="modal-body">
                                            <p class="fs-4 text-secondary">¿Desea anular el pago?</p>
                                        </div>
                                        <div class="modal-footer">
                                            <form asp-action="AnularPago" asp-route-id="@item.Id" method="post">
                                                <button type="submit" class="btn btn-danger">Anular</button>
                                            </form>
                                            <button type="button" class="btn btn-custom" data-bs-dismiss="modal">Cerrar</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="modal-body">
                                            <p class="fs-4 text-secondary">El pago ya ha sido anulado.</p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-custom" data-bs-dismiss="modal">Cerrar</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="modal fade" id="detallePagoModal-@item.Id" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header bg-dark">
                                        <h5 class="modal-title text-light" id="anularPagoModalLabel-@item.Id">Detalle del Pago
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                                            style="filter: invert(1);"></button>
                                    </div>
                                    <div class="modal-body text-start">
                                        <p class="fs-5 text-secondary">@item.Detalle</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-custom" data-bs-dismiss="modal">Cerrar</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </td>
                </tr>
                <div class="modal fade" id="nuevoPagoModal-@item.Id" tabindex="-1"
                    aria-labelledby="nuevoPagoModalLabel-@item.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-dark">
                                <h5 class="modal-title" id="nuevoPagoModalLabel-@item.Id">Nuevo Pago</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="form-group">
                                    <label for="InmuebleTxt" class="control-label fs-5"><b>Inmueble:</b>
                                        @item.Contrato?.Inmueble?.Direccion</label>
                                </div>
                                <div class="form-group mt-2">
                                    <label for="InquilinoTxt" class="control-label fs-5"><b>Inquilino:</b>
                                        @item.Contrato?.Inquilino?.Nombre
                                        @item.Contrato?.Inquilino?.Apellido</label>
                                </div>
                                <form asp-action="Crear" method="post" enctype="multipart/form-data">
                                    <div class="form-group mt-3">
                                        <label name="Importe" class="control-label">Importe</label>
                                        <input name="Importe" class="form-control" value="@item.Contrato?.Inmueble?.Precio"
                                            required readonly />
                                    </div>
                                    <div class="form-group mt-3">
                                        <label name="Detalle" class="control-label">Detalle</label>
                                        <textarea name="Detalle" class="form-control" required rows="3"></textarea>
                                    </div>
                                    <div class="form-group">
                                        <input type="hidden" name="Contrato_id" value="@item.Contrato_id" />
                                    </div>
                                    <div class="form-group mt-3">
                                        <input type="submit" value="Guardar" class="btn btn-custom">
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </tbody>
</table>
<div class="pagination">
    <!-- Botón "Primera página" -->
    @if (Model.CurrentPage > 1)
    {
        <a href="/Pago/Index?pagina=1" class="btn btn-custom">Primera</a>
    }

    <!-- Páginas dinámicas -->
    @{
        int startPage = Math.Max(1, Model.CurrentPage - 1);
        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 1);

        for (int i = startPage; i <= endPage; i++)
        {
            if (i == Model.CurrentPage)
            {
                <span class="btn btn-custom active">@i</span>
            }
            else
            {
                <a href="/Pago/Index?pagina=@i" class="btn btn-custom">@i</a>
            }
        }
    }

    <!-- Botón "Última página" -->
    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="/Pago/Index?pagina=@Model.TotalPages" class="btn btn-custom">Última</a>
    }
</div>
<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="toastContainer"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        @if (TempData["ToastMessage"] != null)
            {
                <text>
                    showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
                </text>
        }
    });

    function showToast(message, type) {
        const toastId = `toast-${Date.now()}`; // ID único para el toast
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;

        const toastContainer = document.getElementById('toastContainer');
        toastContainer.insertAdjacentHTML('beforeend', toastHtml);

        const toastElement = document.getElementById(toastId);
        const bootstrapToast = new bootstrap.Toast(toastElement);
        bootstrapToast.show();

        // Eliminar el toast del DOM cuando se oculta
        toastElement.addEventListener('hidden.bs.toast', () => {
            toastElement.remove();
        });
    }
</script>