@model rivarola_riquelme_rastrilla.Models.Contratos
@{
    ViewData["Title"] = "Crear Contrato";
}
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/Calendar/AltaContratoCalendar.css">

<h1 class="mb-5">@ViewData["Title"]</h1>
<h2 class="border-bottom border-1 border-secondary w-75 text-center mb-4" style="margin: auto">Seleccione la fecha de
    inicio y
    Cantidad de meses del Contrato
</h2>
<form asp-action="AltaContrato" method="post">
    <div class="row mt-3">
        <div class="col-md-12 w-50 mx-auto">
            <div class="row">
                <div class="form-group mt-3 col-md-4">
                    <label asp-for="Fecha_inicio">Fecha de Inicio</label>
                    <input asp-for="Fecha_inicio" id="Fecha_inicio" class="form-control" type="date" required />
                    <span asp-validation-for="Fecha_inicio" class="text-danger"></span>
                </div>
                <div class="form-group mt-3 col-md-4">
                    <label for="Cantidad_meses">Cantidad de Meses</label>
                    <input type="number" name="Cantidad_meses" id="Cantidad_meses" class="form-control" required />
                </div>
                <div class="form-group mt-3 col-md-4 d-none">
                    <label asp-for="Fecha_fin">Fecha de Finalización</label>
                    <input asp-for="Fecha_fin" id="Fecha_fin" class="form-control" type="date" readonly required />
                    <span asp-validation-for="Fecha_fin" class="text-danger"></span>
                </div>
            </div>


            <div class="form-group mt-3">
                <label asp-for="Inquilino_dni">Inquilino</label>
                <select asp-for="Inquilino_dni" class="form-control" required>
                    <option value="">Seleccione un inquilino</option>
                    @foreach (var inquilino in ViewBag.Inquilinos)
                    {
                        <option value="@inquilino.Dni">@inquilino.Nombre</option>
                    }
                </select>
                <span asp-validation-for="Inquilino_dni" class="text-danger"></span>
            </div>

            <div class="form-group mt-3 d-none" id="InmuebleDiv">
                <label asp-for="Inmueble_id">Inmueble</label>
                <select asp-for="Inmueble_id" id="Inmueble_id" class="form-control" required>
                    <option value="">Seleccione un inmueble</option>
                </select>
                <span asp-validation-for="Inmueble_id" class="text-danger"></span>
            </div>

            <div class="form-group mt-3 d-none" id="MontoDiv">
                <label asp-for="Monto"></label>
                <input type="number" asp-for="Monto" id="Monto" class="form-control" readonly required />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="text-center">
        <button type="submit" class="btn btn-custom w-75 mt-5">Crear Contrato</button>
    </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.1/main.min.js"></script>
<script src="~/js/Calendar/AltaContratoCalendar.js"></script>