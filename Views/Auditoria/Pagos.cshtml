@model RegistroPagosViewModel

@{
    ViewData["Title"] = "Auditoría de Pagos";
}

<link rel="stylesheet" href="~/css/pagination.css">

<h1 class="my-2">Auditoría de Pagos</h1>

<table class="mt-5 table table-striped table-hover text-center">
    <thead>
        <tr>
            <th>Pago</th>
            <th>Creado Por</th>
            <th>Fecha de Creación</th>
            <th>Anulado Por</th>
            <th>Fecha de Anulación</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.RegistrosPagos != null)
        {
            @foreach (var registros in Model.RegistrosPagos)
            {
                <tr>
                    <td>
                        <a data-bs-toggle="modal" data-bs-target="#pagoModal-@registros.Pago?.Id" style="cursor: pointer">
                            <i class="fa-solid fa-receipt ic-sz ic-color"></i>
                        </a>
                    </td>
                    <td>
                        <a data-bs-toggle="modal" data-bs-target="#usuarioModal-@registros.Usuario?.Id" style="cursor: pointer">
                            <i class="fa-solid fa-user ic-sz ic-color"></i>
                        </a>
                    </td>
                    <td>@registros.Fecha_creacion</td>
                    <div class="modal fade" id="usuarioModal-@registros.Usuario?.Id" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-dark">
                                    <h5 class="modal-title text-white">Vista del Usuario</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                                        style="filter: invert(1);"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row text-center fs-5 mb-3">
                                        <div class="col-4 text-center align-self-center">
                                            <img src="@registros.Usuario?.Avatar" class="avatar"
                                                style="width: 110px; height: 110px; border-radius: 50%;" />
                                        </div>
                                        <div class="col-8 text-start align-self-center">
                                            <p class="mb-0" style="color: var(--rojo-principal);"><strong>Usuario</strong></p>
                                            <p>@registros.Usuario?.Nombre @registros.Usuario?.Apellido</p>
                                            <p class="mb-0" style="color: var(--rojo-principal);"><strong>Email </strong></p>
                                            <p>@registros.Usuario?.Email</p>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal fade" id="pagoModal-@registros.Pago?.Id" tabindex="-1">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-dark">
                                    <h5 class="modal-title text-white">Vista del Pago</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                                        style="filter: invert(1);"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row text-center fs-5 mb-3">
                                        <div class="col-4 text-start align-self-start">
                                            <p class="mb-2" style="color: var(--rojo-principal);"><strong>Pago</strong></p>
                                            <p><strong>Importe:</strong> $@registros.Pago?.Importe</p>
                                            @if (registros.Pago?.Fecha_pago != null)
                                            {
                                                <p><strong>Fecha de Pago:</strong>
                                                    @registros.Pago?.Fecha_pago.Value.ToString("dd/MM/yyyy")</p>
                                            }
                                            <div class="bg-light p-2"
                                                style="border-style: solid; border-radius: 8px; border-color: var(--rojo-principal); border-width: 2px;">
                                                <p style="font-size: 17px;"><strong>Detalle:</strong> @registros.Pago?.Detalle
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-4 text-start align-self-start">
                                            <p class="mb-2" style="color: var(--rojo-principal);"><strong>Inmueble</strong></p>
                                            <p><strong>Dirección:</strong> @registros.Pago?.Contrato?.Inmueble?.Direccion</p>
                                            <p><strong>Coordenadas:</strong> @registros.Pago?.Contrato?.Inmueble?.Coordenadas
                                            </p>
                                        </div>
                                        <div class="col-4 text-start align-self-start">
                                            <p class="mb-2" style="color: var(--rojo-principal);"><strong>Inquilino</strong></p>
                                            <p><strong>Nombre:</strong> @registros.Pago?.Contrato?.Inquilino?.Nombre</p>
                                            <p><strong>Apellido:</strong> @registros.Pago?.Contrato?.Inquilino?.Apellido</p>
                                            <p><strong>DNI:</strong> @registros.Pago?.Contrato?.Inquilino?.Dni</p>
                                            <p><strong>Email:</strong> @registros.Pago?.Contrato?.Inquilino?.Email</p>
                                            <a href="@($"https://wa.me/549{registros.Pago?.Contrato?.Inquilino?.Telefono}")"
                                                target="_blank" style="cursor: pointer; color: var(--rojo-principal);">Telefono:
                                                @registros.Pago?.Contrato?.Inquilino?.Telefono</a>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (registros.Pago?.Activo == true)
                    {
                        <td><span class="badge bg-success">Aún Activo</span></td>
                        <td><span class="badge bg-success">Aún Activo</span></td>
                    }
                    else
                    {
                        <td>
                            <a data-bs-toggle="modal" data-bs-target="#usuarioCancelModal-@registros.Usuario2?.Id"
                                style="cursor: pointer">
                                <i class="fa-solid fa-user-slash ic-sz ic-color"></i>
                            </a>
                        </td>
                        <td>@registros.Fecha_anulacion</td>
                    }
                    <div class="modal fade" id="usuarioCancelModal-@registros.Usuario2?.Id" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-dark">
                                    <h5 class="modal-title text-white">Vista del Usuario</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                                        style="filter: invert(1);"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row text-center fs-5 mb-3">
                                        <div class="col-4 text-center align-self-center">
                                            <img src="@registros.Usuario2?.Avatar" class="avatar"
                                                style="width: 110px; height: 110px; border-radius: 50%;" />
                                        </div>
                                        <div class="col-8 text-start align-self-center">
                                            <p class="mb-0" style="color: var(--rojo-principal);"><strong>Usuario</strong></p>
                                            <p>@registros.Usuario2?.Nombre @registros.Usuario2?.Apellido</p>
                                            <p class="mb-0" style="color: var(--rojo-principal);"><strong>Email </strong></p>
                                            <p>@registros.Usuario2?.Email</p>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </tr>
            }
        }
    </tbody>
</table>

<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a href="/Auditoria/Pagos?pagina=1" class="btn btn-custom">Primera</a>
    }

    @{
        int startPage = Math.Max(1, Model.CurrentPage - 1);
        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 1);

        for (int i = startPage; i <= endPage; i++)
        {
            if (i == Model.CurrentPage)
            {
                <span class="btn btn-custom active">@i</span>
            }
            else
            {
                <a href="/Auditoria/Pagos?pagina=@i" class="btn btn-custom">@i</a>
            }
        }
    }

    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="/Auditoria/Pagos?pagina=@Model.TotalPages" class="btn btn-custom">Última</a>
    }
</div>