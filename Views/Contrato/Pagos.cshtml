@model PagoViewModel

@{
    ViewData["Title"] = "Pagos de Contrato";
}

<link rel="stylesheet" href="~/css/pagination.css">
@if (Model.Pagos != null && Model.Pagos.Any())
{
    <h1>Pagos</h1>

    <a class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#nuevoPagoModal"><i class="fa-solid fa-plus"></i></a>

    <table class="table table-striped table-hover text-center">
        <thead>
            <tr>
                <th scope="col">Detalles</th>
                <th scope="col">Importe</th>
                <th scope="col">Fecha</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pago in Model.Pagos)
            {
                <tr>
                    <td>@pago.Detalle</td>
                    <td>$@pago.Importe</td>
                    <td>@String.Format("{0:dd/MM/yyyy}", pago.Fecha_pago)</td>
                    <td>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a href="/Pago/Delete/@pago.Id" class="me-2"><i class="fa-solid fa-trash ic-sz ic-color"></i></a>
                        }
                        <a href="/Pago/Edit/@pago.Id" class="me-2"><i class="fa-solid fa-pencil ic-sz ic-color"></i></a>
                        <a href="/Pago/Details/@pago.Id"><i class="fa-solid fa-circle-info ic-sz ic-color"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="modal fade" id="nuevoPagoModal" tabindex="-1" aria-labelledby="nuevoPagoModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark">
                    <h5 class="modal-title" id="nuevoPagoModalLabel">Nuevo Pago</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-controller="Pago" asp-action="Crear" method="post" enctype="multipart/form-data">
                        <div class="form-group mt-3">
                            <label name="Fecha_pago" class="control-label">Fecha de Pago</label>
                            <input name="Fecha_pago" class="form-control" type="date" required />
                        </div>
                        <div class="form-group mt-3">
                            <label name="Importe" class="control-label">Importe</label>
                            <input type="number" name="Importe" class="form-control" required />
                        </div>
                        <div class="form-group mt-3">
                            <label name="Detalle" class="control-label">Detalle</label>
                            <textarea name="Detalle" class="form-control" required rows="3"></textarea>
                        </div>
                        <div class="form-group">
                            <input type="hidden" name="Contrato_id" value="@Model.ContratoId" />
                        </div>
                        <div class="form-group mt-3">
                            <input type="submit" value="Guardar" class="btn btn-custom">
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p class="fs-2">No existen pagos para este Contrato</p>
    <a data-bs-toggle="modal" data-bs-target="#nuevoPagoModal" class="btn btn-custom"><i class="fa-solid fa-plus"></i></a>
    <div class="modal fade" id="nuevoPagoModal" tabindex="-1" aria-labelledby="nuevoPagoModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-dark">
                    <h5 class="modal-title" id="nuevoPagoModalLabel">Nuevo Pago</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-controller="Pago" asp-action="Crear" method="post" enctype="multipart/form-data">
                        <div class="form-group mt-3">
                            <label name="Fecha_pago" class="control-label">Fecha de Pago</label>
                            <input name="Fecha_pago" class="form-control" type="date" required />
                        </div>
                        <div class="form-group mt-3">
                            <label name="Importe" class="control-label">Importe</label>
                            <input type="number" name="Importe" class="form-control" required />
                        </div>
                        <div class="form-group mt-3">
                            <label name="Detalle" class="control-label">Detalle</label>
                            <textarea name="Detalle" class="form-control" required rows="3"></textarea>
                        </div>
                        <div class="form-group">
                            <input type="hidden" name="Contrato_id" value="@Model.ContratoId" />
                        </div>
                        <div class="form-group mt-3">
                            <input type="submit" value="Guardar" class="btn btn-custom">
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}



<div class="pagination">
    <!-- Botón "Primera página" -->
    @if (Model.CurrentPage > 1)
    {
        <a href="/Contrato/Pagos?contratoId=@Model.ContratoId&pagina=1" class="btn btn-custom">Primera</a>
    }

    <!-- Páginas dinámicas -->
    @{
        int startPage = Math.Max(1, Model.CurrentPage - 1);
        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 1);

        for (int i = startPage; i <= endPage; i++)
        {
            if (i == Model.CurrentPage)
            {
                <span class="btn btn-custom active">@i</span>
            }
            else
            {
                <a href="/Contrato/Pagos?contratoId=@Model.ContratoId&pagina=@i" class="btn btn-custom">@i</a>
            }
        }
    }

    <!-- Botón "Última página" -->
    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="/Contrato/Pagos?contratoId=@Model.ContratoId&pagina=@Model.TotalPages" class="btn btn-custom">Última</a>
    }
</div>
<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="toastContainer"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    @if (TempData["ToastMessage"] != null)
    {
        <text>
                    showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
        </text>
    }
    });

    function showToast(message, type) {
        const toastId = `toast-${Date.now()}`; // ID único para el toast
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;

        const toastContainer = document.getElementById('toastContainer');
        toastContainer.insertAdjacentHTML('beforeend', toastHtml);

        const toastElement = document.getElementById(toastId);
        const bootstrapToast = new bootstrap.Toast(toastElement);
        bootstrapToast.show();

        // Eliminar el toast del DOM cuando se oculta
        toastElement.addEventListener('hidden.bs.toast', () => {
            toastElement.remove();
        });
    }
</script>