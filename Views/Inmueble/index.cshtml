@model InmuebleViewModel

@{
    ViewData["Title"] = "Inmuebles";
}

<link href="~/css/pagination.css" rel="stylesheet" />

<div>
    <h1 class="display-4">Lista de Inmuebles</h1>
</div>

<p>
    <a asp-action="AltaInmueble" class="btn btn-custom">Agregar
        <i class="fa-solid fa-plus"></i>
    </a>
</p>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@* MODAL FILTROS *@
<button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#filtrarModal">
    <i class="fa-solid fa-filter"></i> Filtrar
</button>
<a href="@Url.Action("Index")" class="btn btn-custom">
    <i class="fa-solid fa-xmark"></i>
</a>

<div class="modal fade" id="filtrarModal" tabindex="-1" aria-labelledby="filtrarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header text-white" style="background-color: var(--rojo-oscuro);">
                <h5 class=" modal-title" id="filtrarModalLabel">Filtrar Inmuebles</h5>
                <button type="button" class="btn-close text-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form asp-action="Index" class="mb-4" method="get">
                    <div class="form-group">
                        <label for="tipo">Seleccione el tipo de inmueble:</label>
                        <div class="d-flex gap-2">
                            <select id="tipo" name="tipo" class="form-control">
                                <option value="0"></option>
                                @foreach (var tipo in ViewBag.tipos as List<Tipo>)
                                {
                                    <option value="@tipo.Id">@tipo.Nombre</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-custom">Filtrar</button>
                        </div>
                    </div>
                </form>

                <form asp-action="Index" class="mb-4" method="get">
                    <div class="form-group mt-2">
                        <label for="precioMin">Precio Mínimo:</label>
                        <input type="number" id="precioMin" name="precioMin" class="form-control" min="0" />
                    </div>

                    <div class="form-group mt-2">
                        <label for="precioMax">Precio Máximo:</label>
                        <input type="number" id="precioMax" name="precioMax" class="form-control" min="0" />
                    </div>

                    <button type="submit" class="btn btn-custom mt-2">Filtrar por Precio</button>
                </form>

                <form asp-action="Index" class="mb-4" method="get">
                    <div class="form-group">
                        <label for="uso">Seleccione el uso del inmueble:</label>
                        <div class="d-flex gap-2">
                            <select id="uso" name="uso" class="form-control">
                                <option value="0"></option>
                                <option value="residencial">Residencial</option>
                                <option value="comercial">Comercial</option>
                            </select>
                            <button type="submit" class="btn btn-custom">Filtrar</button>
                        </div>
                    </div>
                </form>

                <form asp-action="Index" class="mb-4" method="get">
                    <div class="form-group">
                        <label for="ambientes">Seleccione el número de ambientes:</label>
                        <div class="d-flex gap-2">
                            <input type="number" id="ambientes" name="ambientes" class="form-control" min="0" />
                            <button type="submit" class="btn btn-custom">Filtrar</button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer" style="background-color: #383838;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


<br>

<table class="table table-striped table-hover text-center">
    <thead>
        <tr>
            <th>Direccion</th>
            <th>Propietario</th>
            <th>Uso</th>
            <th>Tipo</th>
            <th>Ambientes</th>
            <th>Precio</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Inmuebles != null)
            @foreach (var item in Model.Inmuebles)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Direccion)
                    </td>
                    <td>
                        @item.Propietario.Nombre @item.Propietario.Apellido
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Uso)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Tipo.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Ambientes)
                    </td>
                    <td>
                        $@Html.DisplayFor(modelItem => item.Precio)
                    </td>
                    <td>
                        @if (item.Estado)
                        {
                            <a href="/Inmueble/Baja/@item.Id" class="btn btn-desactivar"></a>
                        }
                        else
                        {
                            <a href="/Inmueble/Activar/@item.Id" class="btn btn-activar"></a>
                        }
                    </td>
                    <td>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a href="/Inmueble/Delete/@item.Id" class="me-2"><i class="fa-solid fa-trash ic-sz ic-color"></i></a>
                        }
                        <a href="/Inmueble/Editar/@item.Id" class="me-2"><i class="fa-solid fa-pencil ic-sz ic-color"></i></a>
                        <a href="/Inmueble/Details/@item.Id" class="me-2"><i
                                class="fa-solid fa-circle-info ic-sz ic-color"></i></a>
                        <a asp-controller="Inmueble" asp-action="Contratos" asp-route-inmuebleId="@item.Id">
                            <i class="fa-solid fa-file-contract ic-sz ic-color"></i>
                        </a>
                    </td>
                </tr>
            }
    </tbody>
</table>

<div class="pagination">
    <!-- Botón "Primera página" -->
    @if (Model.CurrentPage > 1)
    {
        <a href="@Url.Action("Index", new { 
            tipo = ViewContext.HttpContext.Request.Query["tipo"], 
            uso = ViewContext.HttpContext.Request.Query["uso"], 
            precioMin = ViewContext.HttpContext.Request.Query["precioMin"], 
            precioMax = ViewContext.HttpContext.Request.Query["precioMax"], 
            ambientes = ViewContext.HttpContext.Request.Query["ambientes"], 
            page = 1 
        })" class="btn btn-custom">Primera</a>
    }

    <!-- Páginas dinámicas -->
    @{
        int startPage = Math.Max(1, Model.CurrentPage - 1);
        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 1);

        for (int i = startPage; i <= endPage; i++)
        {
            if (i == Model.CurrentPage)
            {
                <span class="btn btn-custom active">@i</span>
            }
            else
            {
                <a href="@Url.Action("Index", new { 
                    tipo = ViewContext.HttpContext.Request.Query["tipo"], 
                    uso = ViewContext.HttpContext.Request.Query["uso"], 
                    precioMin = ViewContext.HttpContext.Request.Query["precioMin"], 
                    precioMax = ViewContext.HttpContext.Request.Query["precioMax"], 
                    ambientes = ViewContext.HttpContext.Request.Query["ambientes"], 
                    page = i
                })" class="btn btn-custom">@i</a>
            }
        }
    }
    <!-- Botón "Última página" -->
    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="@Url.Action("Index", new { 
            tipo = ViewContext.HttpContext.Request.Query["tipo"], 
            uso = ViewContext.HttpContext.Request.Query["uso"], 
            precioMin = ViewContext.HttpContext.Request.Query["precioMin"], 
            precioMax = ViewContext.HttpContext.Request.Query["precioMax"], 
            ambientes = ViewContext.HttpContext.Request.Query["ambientes"], 
            page = @Model.TotalPages
        })" class="btn btn-custom">Última</a>
    }
</div>

<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="toastContainer"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    @if (TempData["ToastMessage"] != null)
    {
        <text>
                    showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
        </text>
    }
    });

    function showToast(message, type) {
        const toastId = `toast-${Date.now()}`; // ID único para el toast
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;

        const toastContainer = document.getElementById('toastContainer');
        toastContainer.insertAdjacentHTML('beforeend', toastHtml);

        const toastElement = document.getElementById(toastId);
        const bootstrapToast = new bootstrap.Toast(toastElement);
        bootstrapToast.show();

        // Eliminar el toast del DOM cuando se oculta
        toastElement.addEventListener('hidden.bs.toast', () => {
            toastElement.remove();
        });
    }
</script>

<style>
    .btn-desactivar {
        padding: 1.2rem 3.2rem;
        background-color: #C0392B;
        color: white;
        border-radius: 7px;
        position: relative;
        cursor: pointer;
        overflow: hidden;
    }

    .btn-desactivar::before {
        content: 'Disponible';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        transition: transform 0.2s ease, opacity 0.2s ease;
        color: white;
    }

    .btn-desactivar::after {
        content: 'Desactivar';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0);
        transition: transform 0.2s ease, opacity 0.2s ease;
        color: white;
        opacity: 0;
    }

    .btn-desactivar:hover {
        background-color: #ff2c15;
    }

    .btn-desactivar:hover::before {
        transform: translate(-50%, -50%) scale(3);
        opacity: 0;
    }

    .btn-desactivar:hover::after {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
    }


    .btn-activar {
        padding: 1.2rem 3.2rem;
        font-size: 1rem;
        background-color: #C0392B;
        color: white;
        border-radius: 7px;
        position: relative;
        cursor: pointer;
        overflow: hidden;
    }

    .btn-activar::before {
        content: 'No Disponible';
        font-size: 0.9rem;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        transition: transform 0.2s ease, opacity 0.2s ease;
        color: white;
    }

    .btn-activar::after {
        content: 'Activar';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0);
        transition: transform 0.2s ease, opacity 0.2s ease;
        color: white;
        opacity: 0;
    }

    .btn-activar:hover {
        background-color: #09ab03;
    }

    .btn-activar:hover::before {
        transform: translate(-50%, -50%) scale(3);
        opacity: 0;
    }

    .btn-activar:hover::after {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
    }
</style>
