@model IEnumerable<rivarola_riquelme_rastrilla.Models.Pago>

@{
    ViewData["Title"] = "Pagos de Contrato";
}

<h1>Pagos</h1>

<a href="@Url.Action("NuevoPago", "Pago", new { id = Model.First().Contrato_id })" class="btn btn-custom"><i
        class="fa-solid fa-plus"></i></a>
<table class="table table-striped table-hover text-center">
    <thead>
        <tr>
            <th scope="col">Detalles</th>
            <th scope="col">Importe</th>
            <th scope="col">Fecha</th>
            <th scope="col">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pago in Model)
        {
            <tr>
                <td>@pago.Detalle</td>
                <td>$@pago.Importe</td>
                <td>@pago.Fecha_pago</td>
                <td>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a href="/Pago/Delete/@pago.Id" class="me-2"><i class="fa-solid fa-trash ic-sz ic-color"></i></a>
                    }
                    <a href="/Pago/Edit/@pago.Id" class="me-2"><i class="fa-solid fa-pencil ic-sz ic-color"></i></a>
                    <a href="/Pago/Details/@pago.Id"><i class="fa-solid fa-circle-info ic-sz ic-color"></i></a>
                    <a href="/Pago/NuevoPago/@pago.Id"><i class="fa-solid fa-plus ic-sz ic-color"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>