@model rivarola_riquelme_rastrilla.Models.Inquilino

@{
    ViewData["Title"] = "Alta de Inquilinos";
}
<style href="~/css/InquilinoStyle/validacionInquilinoStyle.css"></style>

<h2>Crear Inquilino</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.Error
    </div>
}

<form asp-action="AltaInquilino" method="post">
    <div class="form-group">
        <label asp-for="Dni" class="control-label"></label>
        <input asp-for="Dni" class="form-control" required
        oninput="this.value = this.value.replace(/[^0-9]/g, ''); if (this.value.length > 8) this.value = this.value.slice(0, 8);"/>
    </div>
    <div class="form-group">
        <label asp-for="Nombre" class="control-label"></label>
        <input asp-for="Nombre" class="form-control" required
        oninput="this.value = this.value.replace(/[^a-zA-ZÁÉÍÓÚáéíóúÑñ\s]/g, '').trim();" />
    </div>
    <div class="form-group">
        <label asp-for="Apellido" class="control-label"></label>
        <input asp-for="Apellido" class="form-control" required
        oninput="this.value = this.value.replace(/[^a-zA-ZÁÉÍÓÚáéíóúÑñ\s]/g, '').trim();" />
    </div>
    <div class="form-group">
        <label asp-for="Telefono" class="control-label"></label>
        <input asp-for="Telefono" class="form-control" required 
        oninput="this.value = this.value.replace(/[^0-9]/g, ''); if (this.value.length > 10) this.value = this.value.slice(0, 10);"/>
    </div>
    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" required/>
    </div>
    <div class="form-group mt-3">
        <input type="submit" value="Crear" class="btn btn-custom" />
        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

<script src="~/js/InquilinoScript/validacionInquilinoScript.js"></script>