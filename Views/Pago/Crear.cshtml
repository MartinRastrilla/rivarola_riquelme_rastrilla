@model rivarola_riquelme_rastrilla.Models.Pago

@{
    ViewData["Title"] = "Crear Pago";
}

<h2>Crear Pago</h2>

<form asp-action="Crear" method="post" class="mt-3 w-75">
    <div class="form-group">
        <label asp-for="Contrato_id" class="control-label">Elija un Contrato:</label>
        <input type="text" id="ContratoTxt" class="form-control" list="ContratosList" placeholder="Buscar contrato..."
            required>
        <datalist id="ContratosList">
            @foreach (var contrato in ViewBag.Contratos)
            {
                <option
                    value="@contrato.Id - @contrato.Inquilino?.Nombre @contrato.Inquilino?.Apellido - @contrato.Inmueble?.Direccion">
                </option>
            }
        </datalist>
        <input type="hidden" id="Contrato_id" name="Contrato_id">
        <small id="errorContrato" class="text-danger d-none">Debe seleccionar un elemento de la lista.</small>
    </div>
    <div class="form-group mt-3">
        <label asp-for="Detalle" class="control-label"></label>
        <input asp-for="Detalle" class="form-control" required />
        <span asp-validation-for="Detalle" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="Importe" class="control-label"></label>
        <input type="number" asp-for="Importe" class="form-control" required readonly />
        <span asp-validation-for="Importe" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <input type="submit" value="Crear" class="btn btn-custom" />
        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

<script src="~/js/PagoScript/CrearPago.js"></script>