@{
    ViewData["Title"] = "Auditoria";
}

<div class="row mt-5">
    <div class="col-md-6">
        <a href="/Auditoria/Contratos" class="text-decoration-none">
            <div class="card text-center shadow-lg" style="border-radius: 15px;">
                <div class="card-body">
                    <i class="fa-solid fa-file-contract fa-5x ic-color"></i>
                    <h3 class="mt-3" style="color: var(--gris-oscuro);">Auditoría Contratos</h3>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a href="/Auditoria/Pagos" class="text-decoration-none">
            <div class="card text-center shadow-lg" style="border-radius: 15px;">
                <div class="card-body">
                    <i class="fa-solid fa-file-invoice-dollar fa-5x ic-color"></i>
                    <h3 class="mt-3" style="color: var(--gris-oscuro);">Auditoría Pagos</h3>
                </div>
            </div>
        </a>
    </div>
</div>