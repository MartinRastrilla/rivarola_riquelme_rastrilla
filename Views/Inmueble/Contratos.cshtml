@model ContratoViewModel

@{
    ViewData["Title"] = "Contratos de Inmueble";
}

<link rel="stylesheet" href="~/css/pagination.css">

@if (Model != null && Model.Contratos.Any())
{
    <h1>Lista de Contratos para @Model.Contratos.First().Inmueble?.Direccion</h1>
    <table class="table table-striped table-hover text-center mt-5">
        <thead>
            <tr>
                <th>Inquilino</th>
                <th>Monto</th>
                <th>Fecha de Inicio</th>
                <th>Fecha de Finalización</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var contrato in Model.Contratos)
            {
                <tr>
                    <td>
                        <a data-bs-toggle="modal" data-bs-target="#inqContactoModal-@contrato.Id"
                            style="cursor: pointer; color: #C0392B;">@contrato.Inquilino?.Nombre
                            @contrato.Inquilino?.Apellido</a>
                    </td>
                    <td>$@contrato.Monto</td>
                    <td>@contrato.Fecha_inicio.ToString("dd/MM/yyyy")</td>
                    <td>@contrato.Fecha_fin.ToString("dd/MM/yyyy")</td>
                    <td>@contrato.Estado</td>
                    <td>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a href="@Url.Action("Delete", "Contrato", new { id = contrato.Id })" class="me-2"><i
                                    class="fa-solid fa-trash ic-sz ic-color"></i></a>
                        }
                        <a href="@Url.Action("Editar", "Contrato", new { id = contrato.Id })" class="me-2"><i
                                class="fa-solid fa-pen-to-square ic-sz ic-color"></i></a>
                        <a href="@Url.Action("Details", "Contrato", new { id = contrato.Id })" class=""><i
                                class="fa-solid fa-circle-info ic-sz ic-color"></i></a>
                    </td>
                </tr>
                <div class="modal fade" id="inqContactoModal-@contrato.Id" tabindex="-1"
                    aria-labelledby="inqContactoModalLabel-@contrato.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-dark">
                                <h5 class="modal-title" id="inqContactoModalLabel-@contrato.Id">Datos de Contacto</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>Nombre y Apellido: @contrato.Inquilino.Nombre @contrato.Inquilino.Apellido</p>
                                <a href="@($"https://wa.me/549{contrato.Inquilino.Telefono}")" target="_blank"
                                    style="color: #C0392B;cursor: pointer;">Telefono: @contrato.Inquilino.Telefono</a>
                                <p class="mt-3">Email: @contrato.Inquilino.Email</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
}
else
{
    <h2>No se encontraron contratos para este inmueble</h2>
}

<div class="pagination">
    <!-- Botón "Primera página" -->
    @if (Model.CurrentPage > 1)
    {
        <a href="/Inmueble/Contratos?inmuebleId=@Model.InmuebleId&pagina=1" class="btn btn-custom">Primera</a>
    }

    <!-- Páginas dinámicas -->
    @{
        int startPage = Math.Max(1, Model.CurrentPage - 1);
        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 1);

        for (int i = startPage; i <= endPage; i++)
        {
            if (i == Model.CurrentPage)
            {
                <span class="btn btn-custom active">@i</span>
            }
            else
            {
                <a href="/Inmueble/Contratos?inmuebleId=@Model.InmuebleId&pagina=@i" class="btn btn-custom">@i</a>
            }
        }
    }

    <!-- Botón "Última página" -->
    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="/Inmueble/Contratos?inmuebleId=@Model.InmuebleId&pagina=@Model.TotalPages"
            class="btn btn-custom">Última</a>
    }
</div>
<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="toastContainer"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        @if (TempData["ToastMessage"] != null)
            {
                <text>
                    showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
                </text>
        }
    });

    function showToast(message, type) {
        const toastId = `toast-${Date.now()}`; // ID único para el toast
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;

        const toastContainer = document.getElementById('toastContainer');
        toastContainer.insertAdjacentHTML('beforeend', toastHtml);

        const toastElement = document.getElementById(toastId);
        const bootstrapToast = new bootstrap.Toast(toastElement);
        bootstrapToast.show();

        // Eliminar el toast del DOM cuando se oculta
        toastElement.addEventListener('hidden.bs.toast', () => {
            toastElement.remove();
        });
    }
</script>