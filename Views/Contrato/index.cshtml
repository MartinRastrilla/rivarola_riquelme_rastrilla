@model IEnumerable<rivarola_riquelme_rastrilla.Models.Contratos>

@{
    ViewData["Title"] = "Contratos";
}

<div>
    <h1 class="display-5">Lista de Contratos</h1>
</div>

<p>
    <a href="/Contrato/AltaContrato" class="btn btn-custom">Crear Contrato</a>
</p>

<!-- Botón para abrir el modal -->
<button type="button" class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#filtrarFechaModal">
    Filtrar por Fecha
</button>

<!-- Modal de Bootstrap -->
<div class="modal fade" id="filtrarFechaModal" tabindex="-1" aria-labelledby="filtrarFechaModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <!-- Encabezado del modal -->
            <div class="modal-header">
                <h5 class="modal-title" id="filtrarFechaModalLabel">Filtrar por Fecha</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Cuerpo del modal -->
            <div class="modal-body">
                <form asp-action="FiltrarFecha" method="get" onsubmit="return validarFechas()">
                    <div class="form-row mb-3">
                        <div class="col">
                            <label for="fechaInicio">Fecha de Inicio</label>
                            <input type="date" id="fechaInicio" name="fechaInicio" class="form-control"
                                value="@ViewData["fechaInicio"]" />
                        </div>
                        <div class="col">
                            <label for="fechaFin">Fecha de Finalización</label>
                            <input type="date" id="fechaFin" name="fechaFin" class="form-control"
                                value="@ViewData["fechaFin"]" />
                        </div>
                        <div class="col align-self-end mt-3">
                            <button type="submit" class="btn btn-custom">Filtrar</button>
                        </div>
                    </div>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }
                </form>
            </div>
            <!-- Pie del modal -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<table class="table text-center table-striped table-hover">
    <thead>
        <tr>
            <th>Inquilino</th>
            <th>Inmueble</th>
            <th>@Html.DisplayNameFor(model => model.Estado)</th>
            <th>@Html.DisplayNameFor(model => model.Monto)</th>
            <th>Fecha de Inicio</th>
            <th>Fecha de Finalización</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a href="/Inquilino/Details?Dni=@item.Inquilino_dni" style="color:#C0392B;">@item.Inquilino.Nombre
                        @item.Inquilino.Apellido</a>
                </td>
                <td>
                    <a href="/Inmueble/Details/@item.Inmueble_id" style="color:#C0392B;">@item.Inmueble.Direccion</a>
                </td>
                <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                <td>$@Html.DisplayFor(modelItem => item.Monto)</td>
                <td>@Html.DisplayFor(modelItem => item.Fecha_inicio)</td>
                <td>@Html.DisplayFor(modelItem => item.Fecha_fin)</td>
                <td>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a href="/Contrato/Delete/@item.Id" class="me-2"><i class="fa-solid fa-trash ic-sz ic-color"></i></a>
                    }
                    <a href="/Contrato/Editar/@item.Id" class="me-2"><i class="fa-solid fa-pencil ic-sz ic-color"></i></a>
                    <a href="/Contrato/Details/@item.Id" class="me-2"><i
                            class="fa-solid fa-circle-info ic-sz ic-color"></i></a>
                    <a href="@Url.Action("Pagos", "Contrato", new { id = item.Id })" class="me-2"><i
                            class="fa-solid fa-file-invoice-dollar ic-sz ic-color"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>
