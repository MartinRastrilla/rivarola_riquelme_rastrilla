@model UsuariosViewModel

@{
    ViewData["Title"] = "Listado de personas";
}

<link href="~/css/pagination.css" rel="stylesheet" />

<div>
    <div class="display-5">Lista de Usuarios</div>
</div>

<h3>
    <a href="/Usuarios/Crear" class="btn btn-custom">Agregar Usuarios</a>
</h3>
<table class="table text-center table-striped table-hover mt-4">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Email</th>
            <th>Rol</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Usuarios != null)
            @foreach (var Usuario in Model.Usuarios)
            {
                <tr>
                    <td>
                        <img src="@Usuario.Avatar" class="avatar" alt="Avatar"
                            style="width: 32px; height: 32px; border-radius: 50%;" />
                    </td>
                    <td>
                        @Usuario.Nombre
                    </td>
                    <td>
                        @Usuario.Apellido
                    </td>
                    <td>
                        @Usuario.Email
                    </td>
                    <td>
                        @Usuario.Rol
                    </td>
                    <td>
                        <a href="/Usuarios/Delete/@Usuario.Id" class="me-2"><i class="fa-solid fa-trash ic-sz ic-color"></i></a>
                        <a href="/Usuarios/Editar/@Usuario.Id" class="me-2"><i
                                class="fa-solid fa-pencil ic-sz ic-color"></i></a>
                        <a href="/Usuarios/Details/@Usuario.Id"><i class="fa-solid fa-circle-info ic-sz ic-color"></i></a>
                    </td>
                </tr>
            }
    </tbody>
</table>

<div class="pagination">
    @if (Model.CurrentPage > 1)
    {
        <a href="/Usuarios/Index?pagina=1" class="btn btn-custom">Primera</a>
    }

    @{
        int startPage = Math.Max(1, Model.CurrentPage - 1);
        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 1);

        for (int i = startPage; i <= endPage; i++)
        {
            if (i == Model.CurrentPage)
            {
                <span class="btn btn-custom active">@i</span>
            }
            else
            {
                <a href="/Usuarios/Index?pagina=@i" class="btn btn-custom">@i</a>
            }
        }
    }
    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="/Usuarios/Index?pagina=@Model.TotalPages" class="btn btn-custom">Última</a>
    }
</div>

<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="toastContainer"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    @if (TempData["ToastMessage"] != null)
    {
        <text>
                    showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
        </text>
    }
    });

    function showToast(message, type) {
        const toastId = `toast-${Date.now()}`; // ID único para el toast
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;

        const toastContainer = document.getElementById('toastContainer');
        toastContainer.insertAdjacentHTML('beforeend', toastHtml);

        const toastElement = document.getElementById(toastId);
        const bootstrapToast = new bootstrap.Toast(toastElement);
        bootstrapToast.show();

        // Eliminar el toast del DOM cuando se oculta
        toastElement.addEventListener('hidden.bs.toast', () => {
            toastElement.remove();
        });
    }
</script>