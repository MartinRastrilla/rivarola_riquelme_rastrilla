@{
    ViewData["Title"] = "Inicio";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <!-- Panel de Usuarios -->
        @if (User.IsInRole("Administrador"))
        {
            <div class="col-md-5 mx-2">
                <a href="/Usuarios" style="text-decoration: none;">
                    <div class="card text-center shadow-lg"
                        style="background-color: var(--blanco); border: 1px solid var(--gris-claro); border-radius: 10px;">
                        <div class="card-body">
                            <i class="fa-solid fa-user fa-4x ic-color"></i> <!-- Ícono para Usuarios -->
                            <h3 class="mt-3" style="color: var(--gris-oscuro);">Usuarios</h3>
                        </div>
                    </div>
                </a>
            </div>
        }
        <!-- Panel de Inmobiliaria -->
        <div class="col-md-5 mx-2">
            <a href="/Inquilino" style="text-decoration: none;">
                <div class="card text-center shadow-lg"
                    style="background-color: var(--blanco); border: 1px solid var(--gris-claro); border-radius: 10px;">
                    <div class="card-body">
                        <i class="fa-solid fa-building fa-4x ic-color"></i>
                        <h3 class="mt-3" style="color: var(--gris-oscuro);">Inmobiliaria</h3>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="toastContainer"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    @if (TempData["ToastMessage"] != null)
    {
        <text>
                    showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
        </text>
    }
    });

    function showToast(message, type) {
        const toastId = `toast-${Date.now()}`; // ID único para el toast
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;

        const toastContainer = document.getElementById('toastContainer');
        toastContainer.insertAdjacentHTML('beforeend', toastHtml);

        const toastElement = document.getElementById(toastId);
        const bootstrapToast = new bootstrap.Toast(toastElement);
        bootstrapToast.show();

        // Eliminar el toast del DOM cuando se oculta
        toastElement.addEventListener('hidden.bs.toast', () => {
            toastElement.remove();
        });
    }
</script>

<style>
    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
    }

    .ic-color {
        color: var(--rojo-oscuro);
    }

    a:hover {
        text-decoration: none;
    }
</style>
