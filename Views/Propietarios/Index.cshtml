@model PropietarioViewModel

@{
    ViewData["Title"] = "Propietarios";
}

<link href="~/css/pagination.css" rel="stylesheet" />

<div>
    <h1 class="display-5">Lista de Propietarios</h1>
</div>

<div class="my-3 row">
    <p class="col-md-9 mb-0 align-self-center">
        <a asp-action="Crear" class="btn btn-custom">Agregar Propietario</a>
    </p>
    <form asp-action="Index" method="GET" class="input-wrapper col-md-3" id="searchForm">
        <button type="submit" class="icon" id="searchButton">
            <i class="fa-solid fa-magnifying-glass fs-3 fa-bounce"></i>
        </button>
        <input type="text" name="search" id="searchInput" class="input" placeholder="Buscar Propietario..."
            value="@ViewBag.Search">
    </form>
</div>

<table class="table table-striped table-hover text-center">
    <thead>
        <tr>
            <th>Dni</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Telefono</th>
            <th>Email</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Propietarios != null)
            @foreach (var item in Model.Propietarios)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Dni)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Apellido)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Telefono)
                    </td>
                    <td>
                        <a href="mailto:@item.Email" style="color: #C0392B;">@item.Email</a>
                    </td>
                    <td>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a href="/Propietarios/Delete/@item.Id" class="me-2"><i
                                    class="fa-solid fa-trash ic-sz ic-color"></i></a>
                        }
                        <a href="/Propietarios/Edit/@item.Id" class="me-2"><i class="fa-solid fa-pencil ic-sz ic-color"></i></a>
                        <a href="/Propietarios/Details/@item.Id" class="me-2"><i
                                class="fa-solid fa-circle-info ic-sz ic-color"></i></a>
                        <a asp-controller="Propietarios" asp-action="Inmuebles" asp-route-dni="@item.Dni">
                            <i class="fa-solid fa-building ic-sz ic-color"></i>
                        </a>
                    </td>
                </tr>
            }
    </tbody>
</table>
<div class="pagination">
    <!-- Botón "Primera página" -->
    @if (Model.CurrentPage > 1)
    {
        <a href="/Propietarios/Index?pagina=1" class="btn btn-custom">Primera</a>
    }

    <!-- Páginas dinámicas -->
    @{
        int startPage = Math.Max(1, Model.CurrentPage - 1);
        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 1);

        for (int i = startPage; i <= endPage; i++)
        {
            if (i == Model.CurrentPage)
            {
                <span class="btn btn-custom active">@i</span>
            }
            else
            {
                <a href="/Propietarios/Index?pagina=@i" class="btn btn-custom">@i</a>
            }
        }
    }
    <!-- Botón "Última página" -->
    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="/Propietarios/Index?pagina=@Model.TotalPages" class="btn btn-custom">Última</a>
    }
</div>

<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="toastContainer"></div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        @if (TempData["ToastMessage"] != null)
            {
                <text>
                    showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
                </text>
        }
    });

    function showToast(message, type) {
        const toastId = `toast-${Date.now()}`; // ID único para el toast
        const toastHtml = `
            <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;

        const toastContainer = document.getElementById('toastContainer');
        toastContainer.insertAdjacentHTML('beforeend', toastHtml);

        const toastElement = document.getElementById(toastId);
        const bootstrapToast = new bootstrap.Toast(toastElement);
        bootstrapToast.show();

        // Eliminar el toast del DOM cuando se oculta
        toastElement.addEventListener('hidden.bs.toast', () => {
            toastElement.remove();
        });
    }
</script>